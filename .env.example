# Foreman demo configuration.
#
# Copy this file to .env and fill in your own values. .env is git-ignored and
# must never be committed. Every value below is a placeholder.
#
# This is a demo. Do not put real Blue Collar Workflows endpoints, keys,
# customer data or credentials anywhere in this repo. See docs/demo-guardrails.md.

# --- LLM provider (ADR-0003) ---
# Which IChatClient implementation the API registers.
FOREMAN_LLM_PROVIDER=anthropic
# Model name for the chosen provider.
FOREMAN_LLM_MODEL=
# Your own personal API key. Never commit it.
FOREMAN_LLM_API_KEY=replace-me

# --- API (ADR-0001, ADR-0004) ---
ASPNETCORE_ENVIRONMENT=Development
FOREMAN_API_URL=http://localhost:5080
# Local SQLite file. Created from migrations and seed data. Git-ignored.
FOREMAN_DB_PATH=./data/foreman-demo.db

# --- MCP server (ADR-0002) ---
# http when the API calls the server, stdio for MCP Inspector / Claude Desktop.
FOREMAN_MCP_TRANSPORT=http
FOREMAN_MCP_URL=http://localhost:5090/mcp

# --- Demo auth (BCW-22) ---
# Local-only signing secret for demo sign-in. Generate your own random value.
FOREMAN_DEMO_AUTH_SECRET=replace-me
